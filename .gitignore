# OS
.DS_Store
nul

# Node
node_modules/
build/
dist/
package-lock.json

# Python
.venv/
*.tgz
*.egg-info/
__pycache__/
*.py[cod]

# Packed release artifacts are committed: the tag-triggered GitHub Release
# uploads exactly these files without rebuilding. The negations must come
# after the global `*.tgz` rule to take effect, and the parent directory is
# not excluded so the files below can be re-included.
!dist-packages/manifest.json
!dist-packages/*.tgz

# Project
output.json
examples/**/artifacts/
examples/**/*.db
examples/**/*.db-shm
examples/**/*.db-wal
.test/
.tmp*/

# Binary test samples (large; fetch separately)
examples/*.apk
.peak*
.pi-probe*/

# Code intelligence cache
.codegraph/
.zcode
.agents/

# Test root created by scripts/run-example.mjs
.peak_test/
